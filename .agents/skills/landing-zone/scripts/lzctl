#!/usr/bin/env python3
"""lzctl: deterministic landing zone tooling shared by every agent host.

Commands:
  spec validate <spec.json>          Check a spec against the core and per-cloud schemas.
  render <spec.json> --out <dir>     Render a valid spec into FAST configuration data (GCP).
  check <dir>                        Verify a rendered directory: integrity, upstream schemas, formatting, scans.
  explain [dir] [--findings <file>]  Map findings back to the spec fields that caused them.
  doctor                             Check runtime dependencies.

Exit codes: 0 clean, 1 findings or render refused, 2 usage or environment error.
Requires Python 3.11+, jsonschema, jinja2 and PyYAML.
"""

from __future__ import annotations

import argparse
import hashlib
import ipaddress
import json
import os
import re
import shutil
import subprocess
import sys
from importlib import metadata
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent.parent
SCHEMA_DIR = SKILL_DIR / "schemas"
TEMPLATE_DIR = SKILL_DIR / "templates"

EXIT_OK, EXIT_FINDINGS, EXIT_ERROR = 0, 1, 2

# One pinned baseline per cloud per skill version. Bumping requires re-vendoring
# (tools/vendor_fast.py), updating the overlays and a full eval run.
BASELINES = {
    "gcp": {"tag": "v59.0.0", "dir": "gcp/fast-v59.0.0", "dataset": "classic", "output_dataset": "landing-zone"},
}

# Canonical order, so output never depends on the order in the spec.
ENVIRONMENTS = {
    "dev": {"tag_value": "development", "folder_name": "Development", "description": "Development."},
    "stage": {"tag_value": "staging", "folder_name": "Staging", "description": "Staging."},
    "prod": {"tag_value": "production", "folder_name": "Production", "description": "Production."},
}

# Spec fields the GCP renderer does not turn into configuration yet, with the stage that will.
DEFERRED_GCP = {
    "network.topology": "2-networking dataset",
    "network.cidr_supernet": "2-networking dataset",
    "network.private_service_access": "2-networking dataset",
    "iam.groups.network_admins": "2-networking dataset",
    "iam.groups.security_admins": "2-security dataset",
    "security.service_perimeter": "1-vpcsc and the hardened dataset (regulated profile)",
    "security.customer_managed_keys": "2-security and the hardened dataset (regulated profile)",
    "security.compliance": "policy pack",
    "extensions.gcp.hub_connectivity": "2-networking dataset",
    "extensions.gcp.audit_sink": "additional log sinks",
}

REPORT_NAME = "render-report.json"
SCHEMA_DECLARATION = re.compile(rb"yaml-language-server: \$schema=\S*?([\w-]+\.schema\.json)")

# Checks the design calls for that have nothing to run on yet. Reported, never counted as passed.
NOT_APPLICABLE = {
    "terraform-validate": "needs the FAST stage module, which is not vendored; the output is data files only",
    "tflint": "no HCL is rendered yet",
    "conftest": "no policy pack yet",
}

# Misconfiguration scanners. They run on rendered .tf files and are not_applicable until some exist (ADR-022).
SCAN_TIMEOUT = 120
SUPPRESSION = re.compile(rb"checkov:skip|trivy:ignore|tfsec:ignore", re.IGNORECASE)

TOOLS = {
    "terraform": "fmt and validate (OpenTofu also works)",
    "tflint": "lint",
    "trivy": "misconfiguration scan",
    "checkov": "misconfiguration scan",
    "conftest": "policy checks",
}


class RenderError(Exception):
    """The spec cannot be rendered; the message says why."""


class CheckError(Exception):
    """The directory cannot be checked at all; the message says why."""


def _fail(message: str) -> int:
    print(f"lzctl: {message}", file=sys.stderr)
    return EXIT_ERROR


def _load_json(path: Path) -> object:
    with path.open(encoding="utf-8") as handle:
        return json.load(handle)


def _dotted(path) -> str:
    return ".".join(str(part) for part in path) or "(root)"


def _finding(rule: str, path: str, message: str) -> dict:
    return {"rule": rule, "path": path, "message": message}


def _schema_findings(validator_cls, schema: dict, instance: object) -> list[dict]:
    findings = []
    for error in validator_cls(schema).iter_errors(instance):
        path = _dotted(error.absolute_path)
        if error.validator == "not" and path.endswith("extensions"):
            message = "extensions may only contain the block for target.cloud"
        elif error.validator == "required":
            message = error.message
        else:
            message = error.message if len(error.message) <= 160 else error.message[:157] + "..."
        findings.append(_finding(f"schema.{error.validator}", path, message))
    return findings


def _strings(node: object, path: tuple = ()):
    if isinstance(node, str):
        yield path, node
    elif isinstance(node, dict):
        for key, value in node.items():
            yield from _strings(value, path + (key,))
    elif isinstance(node, list):
        for index, value in enumerate(node):
            yield from _strings(value, path + (index,))


def _semantic_findings(spec: dict) -> list[dict]:
    """Checks JSON Schema can't express."""
    findings = []
    # Python's `$` also matches before a trailing newline, unlike ECMA-262; values reach templates.
    for path, value in _strings(spec):
        if any(ord(ch) < 32 or ord(ch) == 127 for ch in value):
            findings.append(_finding("semantic.control_character", _dotted(path), "control characters are not allowed"))
    cidr = spec.get("network", {}).get("cidr_supernet")
    if isinstance(cidr, str):
        try:
            net = ipaddress.ip_network(cidr, strict=True)
        except ValueError as exc:
            findings.append(_finding("semantic.cidr", "network.cidr_supernet", str(exc)))
        else:
            if net.version != 4 or not net.is_private:
                findings.append(_finding("semantic.cidr", "network.cidr_supernet", f"{cidr} is not a private IPv4 range"))
            elif net.prefixlen > 16:
                findings.append(_finding("semantic.cidr", "network.cidr_supernet", f"{cidr} is too small for a supernet; use /16 or larger"))
    return findings


def validate_spec(spec: object) -> list[dict]:
    try:
        from jsonschema import Draft202012Validator
    except ImportError as exc:
        raise RuntimeError("jsonschema is not installed; run `lzctl doctor`") from exc

    core = _load_json(SCHEMA_DIR / "lz-spec.core.schema.json")
    findings = _schema_findings(Draft202012Validator, core, spec)
    if not isinstance(spec, dict):
        return findings

    findings += _semantic_findings(spec)

    target = spec.get("target")
    cloud = target.get("cloud") if isinstance(target, dict) else None
    if isinstance(cloud, str):
        schema_path = SCHEMA_DIR / f"lz-spec.{cloud}.schema.json"
        if schema_path.exists():
            findings += _schema_findings(Draft202012Validator, _load_json(schema_path), spec)
        else:
            findings.append(_finding("semantic.cloud_unsupported", "target.cloud", f"{cloud} is not supported yet"))

    return sorted(findings, key=lambda f: (f["path"], f["rule"], f["message"]))


# --- render -----------------------------------------------------------------


def _sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _output_hash(digests: dict[str, str]) -> str:
    return _sha256("".join(f"{path}\0{digest}\n" for path, digest in sorted(digests.items())).encode("utf-8"))


def _present(spec: dict, dotted: str) -> bool:
    node: object = spec
    for part in dotted.split("."):
        if not isinstance(node, dict) or part not in node:
            return False
        node = node[part]
    return True


def _load_baseline(cloud: str) -> tuple[dict, Path]:
    baseline = BASELINES.get(cloud)
    if baseline is None:
        raise RenderError(f"{cloud} has no baseline yet")
    root = TEMPLATE_DIR / baseline["dir"]
    manifest = _load_json(root / "MANIFEST.json")
    for relative, expected in manifest["files"].items():
        path = root / "upstream" / relative
        if not path.is_file() or _sha256(path.read_bytes()) != expected:
            raise RenderError(f"vendored upstream file {relative} does not match MANIFEST.json; re-run tools/vendor_fast.py")
    return manifest, root


def render_spec(spec: dict) -> tuple[dict[str, bytes], dict]:
    """Return ({relative path: bytes}, report). Pure: same spec and skill version, same bytes."""
    try:
        import jinja2
    except ImportError as exc:
        raise RuntimeError("jinja2 is not installed; run `lzctl doctor`") from exc

    findings = validate_spec(spec)
    if findings:
        raise RenderError(f"spec is invalid ({len(findings)} findings); run `lzctl spec validate`")

    cloud = spec["target"]["cloud"]
    if spec["target"]["profile"] == "regulated":
        raise RenderError("the regulated profile needs the FAST hardened dataset, which is not supported yet")

    baseline = BASELINES[cloud]
    manifest, root = _load_baseline(cloud)
    if spec["target"]["baseline_version"] != manifest["tag"]:
        raise RenderError(f"baseline_version {spec['target']['baseline_version']} does not match the vendored {manifest['tag']}")

    env = jinja2.Environment(
        loader=jinja2.FileSystemLoader(str(root / "overlay")),
        undefined=jinja2.StrictUndefined,
        trim_blocks=True,
        lstrip_blocks=True,
        keep_trailing_newline=True,
        autoescape=False,
    )

    def render(template: str, **values) -> bytes:
        return env.get_template(template).render(**values).encode("utf-8")

    dataset_prefix = f"datasets/{baseline['output_dataset']}/"
    upstream_dataset = root / "upstream" / "datasets" / baseline["dataset"]
    files: dict[str, bytes] = {}
    for path in sorted(upstream_dataset.rglob("*")):
        if path.is_file():
            files[path.relative_to(upstream_dataset).as_posix()] = path.read_bytes()

    selected = [name for name in ENVIRONMENTS if name in spec["hierarchy"]["environments"]]
    envs = [ENVIRONMENTS[name] for name in selected]

    # Which spec fields drive each generated file; `lzctl explain` reads this back.
    sources: dict[str, list[str]] = {}

    def driven_by(path: str, *fields: str) -> None:
        sources[dataset_prefix + path] = sorted(fields)

    # Environment folders: drop the dataset's own, then render the selected ones.
    for path in [p for p in files if p.startswith(("folders/networking/", "folders/security/")) and p.count("/") == 3]:
        del files[path]
    for name in selected:
        for kind in ("networking", "security"):
            files[f"folders/{kind}/{name}/.config.yaml"] = render(f"folder-{kind}-env.yaml.j2", env=ENVIRONMENTS[name])
            driven_by(f"folders/{kind}/{name}/.config.yaml", "hierarchy.environments")

    for unit in sorted(spec["hierarchy"].get("business_units", [])):
        files[f"folders/teams/{unit}/.config.yaml"] = render("folder-team.yaml.j2", name=unit)
        driven_by(f"folders/teams/{unit}/.config.yaml", "hierarchy.business_units")

    logging = spec["logging"]
    ext = spec["extensions"]["gcp"]
    files["organization/tags/environment.yaml"] = render("tags-environment.yaml.j2", environments=envs)
    files["projects/core/log-0.yaml"] = render(
        "log-0.yaml.j2",
        retention_days=logging["retention_days"],
        log_analytics=logging["audit_destination"] in ("analytics", "both"),
    )
    files["defaults.yaml"] = render(
        "defaults.yaml.j2",
        billing_account=spec["organization"]["billing_ref"],
        domain=spec["organization"]["domain"],
        organization_id=int(spec["organization"]["id"]),
        customer_id=ext["customer_id"],
        prefix=ext["prefix"],
        org_admins=spec["iam"]["groups"]["org_admins"],
        primary_region=spec["network"]["regions"][0],
    )

    driven_by("organization/tags/environment.yaml", "hierarchy.environments")
    driven_by("projects/core/log-0.yaml", "logging.audit_destination", "logging.retention_days")
    driven_by("defaults.yaml", "extensions.gcp.customer_id", "extensions.gcp.prefix", "iam.groups.org_admins",
              "network.regions", "organization.billing_ref", "organization.domain", "organization.id")
    sources["0-org-setup.auto.tfvars"] = ["target.baseline_version"]

    output = {dataset_prefix + path: data for path, data in files.items()}
    output["0-org-setup.auto.tfvars"] = render(
        "factories.tfvars.j2", baseline_tag=manifest["tag"], dataset_name=baseline["output_dataset"]
    )

    digests = {path: _sha256(data) for path, data in sorted(output.items())}
    output_hash = _output_hash(digests)
    deferred = {field: stage for field, stage in DEFERRED_GCP.items() if _present(spec, field)}
    extra_regions = spec["network"]["regions"][1:]
    if extra_regions:
        deferred["network.regions[1:]"] = "2-networking dataset"
    report = {
        "baseline": {"cloud": cloud, "tag": manifest["tag"], "commit": manifest["commit"], "dataset": baseline["dataset"]},
        "output_hash": output_hash,
        "files": digests,
        "not_rendered_yet": dict(sorted(deferred.items())),
        "sources": dict(sorted(sources.items())),
    }
    return output, report


def cmd_render(args: argparse.Namespace) -> int:
    path = Path(args.spec)
    try:
        spec = _load_json(path)
    except FileNotFoundError:
        return _fail(f"{path} not found")
    except json.JSONDecodeError as exc:
        return _fail(f"{path} is not valid JSON: {exc}")
    if not isinstance(spec, dict):
        return _fail(f"{path} must contain a JSON object")

    out = Path(args.out)
    if out.exists() and any(out.iterdir()):
        return _fail(f"{out} exists and is not empty")

    try:
        files, report = render_spec(spec)
    except RenderError as exc:
        print(json.dumps({"rendered": False, "reason": str(exc)}, indent=2))
        return EXIT_FINDINGS
    except RuntimeError as exc:
        return _fail(str(exc))

    for relative, data in files.items():
        target = out / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(data)
    (out / "render-report.json").write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    print(json.dumps({"rendered": True, "out": str(out), "files": len(files), "output_hash": report["output_hash"],
                      "not_rendered_yet": report["not_rendered_yet"]}, indent=2, sort_keys=True))
    return EXIT_OK


# --- check ------------------------------------------------------------------


def _check_result(name: str, status: str, detail: str = "") -> dict:
    return {"name": name, "status": status, "detail": detail}


def _walk_files(directory: Path) -> tuple[dict[str, Path], list[str]]:
    """Regular files by relative path, and symlinks (never followed)."""
    files: dict[str, Path] = {}
    links: list[str] = []
    for root, dirs, names in os.walk(directory, followlinks=False):
        for name in sorted(dirs + names):
            path = Path(root) / name
            if path.is_symlink():
                links.append(path.relative_to(directory).as_posix())
            elif path.is_file():
                files[path.relative_to(directory).as_posix()] = path
    return files, sorted(links)


def _load_report(directory: Path) -> dict:
    path = directory / REPORT_NAME
    if not path.is_file():
        raise CheckError(f"{directory} has no {REPORT_NAME}; render into it first")
    try:
        report = _load_json(path)
    except json.JSONDecodeError as exc:
        raise CheckError(f"{path} is not valid JSON: {exc}") from exc
    files = report.get("files") if isinstance(report, dict) else None
    baseline = report.get("baseline") if isinstance(report, dict) else None
    if (
        not isinstance(files, dict)
        or not all(isinstance(k, str) and isinstance(v, str) for k, v in files.items())
        or not isinstance(report.get("output_hash"), str)
        or not isinstance(baseline, dict)
        or not isinstance(baseline.get("cloud"), str)
    ):
        raise CheckError(f"{path} is not a render report")
    return report


def _integrity_findings(report: dict, on_disk: dict[str, Path], links: list[str]) -> list[dict]:
    findings = [_finding("check.integrity.symlink", link, "symbolic links are not allowed in rendered output") for link in links]
    expected = report["files"]
    for relative in sorted(set(expected) - set(on_disk)):
        findings.append(_finding("check.integrity.missing", relative, "listed in the render report but not on disk"))
    for relative in sorted(set(on_disk) - set(expected) - {REPORT_NAME}):
        findings.append(_finding("check.integrity.extra", relative, "on disk but not in the render report; only `lzctl render` may create files"))
    for relative in sorted(set(expected) & set(on_disk)):
        if _sha256(on_disk[relative].read_bytes()) != expected[relative]:
            findings.append(_finding("check.integrity.modified", relative, "differs from the render report; edit the spec and re-render instead"))
    if _output_hash(expected) != report["output_hash"]:
        findings.append(_finding("check.integrity.output_hash", REPORT_NAME, "output_hash does not match the listed file digests"))
    return findings


def _schema_check(report: dict, on_disk: dict[str, Path]) -> tuple[list[dict], int, int]:
    """Validate YAML against the vendored upstream schemas. Returns (findings, validated, undeclared)."""
    try:
        import yaml
        from jsonschema import validators
    except ImportError as exc:
        raise CheckError("jsonschema or PyYAML is not installed; run `lzctl doctor`") from exc

    cloud = report["baseline"]["cloud"]
    try:
        manifest, root = _load_baseline(cloud)
    except RenderError as exc:
        raise CheckError(str(exc)) from exc
    findings = []
    if report["baseline"].get("tag") != manifest["tag"]:
        findings.append(_finding("check.baseline.mismatch", REPORT_NAME,
                                 f"rendered with {report['baseline'].get('tag')}, but this skill vendors {manifest['tag']}"))

    schema_dir = root / "upstream" / "schemas"
    cache: dict[str, object] = {}
    validated = undeclared = 0
    for relative, path in sorted(on_disk.items()):
        if not relative.endswith((".yaml", ".yml")):
            continue
        data = path.read_bytes()
        try:
            # Some upstream files hold only comments; an empty factory file means an empty map.
            document = yaml.safe_load(data) or {}
        except yaml.YAMLError as exc:
            findings.append(_finding("check.yaml.parse", relative, str(exc).replace("\n", " ")[:160]))
            continue
        declared = SCHEMA_DECLARATION.search(data)
        if declared is None:
            undeclared += 1
            continue
        name = declared.group(1).decode()
        if name not in cache:
            schema_path = schema_dir / name
            cache[name] = _load_json(schema_path) if schema_path.is_file() else None
        schema = cache[name]
        if schema is None:
            findings.append(_finding("check.schema.unknown", relative, f"declares {name}, which is not among the vendored schemas"))
            continue
        validated += 1
        for error in sorted(validators.validator_for(schema)(schema).iter_errors(document), key=lambda e: _dotted(e.absolute_path)):
            message = error.message if len(error.message) <= 160 else error.message[:157] + "..."
            findings.append(_finding(f"check.schema.{error.validator}", relative, f"{_dotted(error.absolute_path)}: {message}"))
    return findings, validated, undeclared


def _terraform_fmt(directory: Path) -> tuple[dict, list[dict]]:
    exe = shutil.which("terraform") or shutil.which("tofu")
    if exe is None:
        return _check_result("terraform-fmt", "skipped", "terraform or tofu is not installed"), []
    env = {**os.environ, "TF_IN_AUTOMATION": "1", "CHECKPOINT_DISABLE": "1"}
    try:
        proc = subprocess.run([exe, "fmt", "-check", "-recursive", "-no-color", "."], cwd=directory,
                              capture_output=True, text=True, timeout=60, env=env, check=False)
    except subprocess.TimeoutExpired:
        return _check_result("terraform-fmt", "failed", "timed out after 60s"), [_finding("check.terraform.fmt", ".", "terraform fmt timed out")]
    if proc.returncode == 0:
        return _check_result("terraform-fmt", "passed"), []
    if proc.returncode == 3:
        files = sorted(line.strip() for line in proc.stdout.splitlines() if line.strip())
        return (_check_result("terraform-fmt", "failed", f"{len(files)} file(s) not formatted"),
                [_finding("check.terraform.fmt", f, "not canonically formatted") for f in files])
    detail = (proc.stderr.strip().splitlines() or ["terraform fmt failed"])[0][:160]
    return _check_result("terraform-fmt", "failed", detail), [_finding("check.terraform.fmt", ".", detail)]


def _run_scanner(argv: list[str], directory: Path, extra_env: dict[str, str]) -> subprocess.CompletedProcess | str:
    """Run a scanner in the rendered directory. Returns the process, or a message if it could not run."""
    try:
        return subprocess.run(argv, cwd=directory, capture_output=True, text=True, timeout=SCAN_TIMEOUT,
                              env={**os.environ, **extra_env}, check=False)
    except subprocess.TimeoutExpired:
        return f"timed out after {SCAN_TIMEOUT}s"
    except OSError as exc:
        return str(exc)


def _scanner_error(name: str, detail: str) -> tuple[dict, list[dict]]:
    detail = detail[:160]
    return _check_result(name, "failed", detail), [_finding(f"check.{name}.error", ".", detail)]


def _scan_trivy(exe: str, directory: Path) -> tuple[dict, list[dict]]:
    # `trivy config` exits 0 even with failures, so read the report, not the exit code.
    proc = _run_scanner([exe, "config", "--format", "json", "--quiet", "--skip-check-update", "."], directory, {})
    if isinstance(proc, str):
        return _scanner_error("trivy", proc)
    if proc.returncode != 0:
        return _scanner_error("trivy", (proc.stderr.strip().splitlines() or [f"exit {proc.returncode}"])[0])
    try:
        results = json.loads(proc.stdout).get("Results") or []
    except (json.JSONDecodeError, AttributeError):
        return _scanner_error("trivy", "output was not a trivy JSON report")
    findings = []
    for result in results:
        for item in result.get("Misconfigurations") or []:
            if item.get("Status") == "FAIL":
                resource = (item.get("CauseMetadata") or {}).get("Resource")
                where = f" ({resource})" if resource else ""
                findings.append(_finding(f"check.trivy.{item.get('ID')}", str(result.get("Target")),
                                         f"{item.get('Title')}{where} [{item.get('Severity')}]"))
    status = "failed" if findings else "passed"
    return _check_result("trivy", status, f"{len(findings)} finding(s)" if findings else "no misconfigurations"), findings


def _scan_checkov(exe: str, directory: Path) -> tuple[dict, list[dict]]:
    # Checkov exits 1 when checks fail; any other non-zero code is an error. --skip-download keeps it offline.
    argv = [exe, "-d", ".", "--framework", "terraform", "--output", "json", "--quiet", "--compact", "--skip-download"]
    proc = _run_scanner(argv, directory, {"BC_SKIP_MAPPING": "TRUE"})
    if isinstance(proc, str):
        return _scanner_error("checkov", proc)
    if proc.returncode not in (0, 1):
        return _scanner_error("checkov", (proc.stderr.strip().splitlines() or [f"exit {proc.returncode}"])[0])
    try:
        reports = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return _scanner_error("checkov", "output was not a checkov JSON report")
    findings = []
    for report in reports if isinstance(reports, list) else [reports]:
        if not isinstance(report, dict):
            return _scanner_error("checkov", "output was not a checkov JSON report")
        if (report.get("summary") or {}).get("parsing_errors"):
            findings.append(_finding("check.checkov.parse", ".", "checkov could not parse some files"))
        for item in (report.get("results") or {}).get("failed_checks") or []:
            findings.append(_finding(f"check.checkov.{item.get('check_id')}", str(item.get("file_path", ".")).lstrip("/"),
                                     f"{item.get('check_name')} ({item.get('resource')})"))
    status = "failed" if findings else "passed"
    return _check_result("checkov", status, f"{len(findings)} finding(s)" if findings else "no misconfigurations"), findings


def _hcl_scans(directory: Path, on_disk: dict[str, Path]) -> tuple[list[dict], list[dict]]:
    scanners = (("trivy", _scan_trivy), ("checkov", _scan_checkov))
    hcl = sorted(relative for relative in on_disk if relative.endswith(".tf"))
    if not hcl:
        return [_check_result(name, "not_applicable", "no .tf files in the rendered output") for name, _ in scanners], []
    # Inline suppressions would let rendered HCL opt out of the scans.
    findings = [_finding("check.hcl.suppression", relative, "inline scanner suppressions are not allowed in rendered output")
                for relative in hcl if SUPPRESSION.search(on_disk[relative].read_bytes())]
    checks = []
    for name, scan in scanners:
        exe = shutil.which(name)
        if exe is None:
            checks.append(_check_result(name, "skipped", f"{name} is not installed"))
            continue
        result, scan_findings = scan(exe, directory)
        checks.append(result)
        findings += scan_findings
    return checks, findings


def check_output(directory: Path) -> tuple[list[dict], list[dict]]:
    """Verify a rendered directory. Returns (checks, findings); findings is empty when clean."""
    report = _load_report(directory)
    on_disk, links = _walk_files(directory)

    integrity = _integrity_findings(report, on_disk, links)
    checks = [_check_result("integrity", "failed" if integrity else "passed",
                            f"{len(integrity)} finding(s)" if integrity else f"{len(report['files'])} files match the render report")]

    schema, validated, undeclared = _schema_check(report, on_disk)
    checks.append(_check_result("upstream-schemas", "failed" if schema else "passed",
                                f"{validated} YAML files validated, {undeclared} declare no schema"))

    fmt_check, fmt = _terraform_fmt(directory)
    checks.append(fmt_check)
    scans, scan_findings = _hcl_scans(directory, on_disk)
    checks += scans
    checks += [_check_result(name, "not_applicable", reason) for name, reason in NOT_APPLICABLE.items()]

    findings = sorted(integrity + schema + fmt + scan_findings, key=lambda f: (f["path"], f["rule"], f["message"]))
    return checks, findings


def cmd_check(args: argparse.Namespace) -> int:
    directory = Path(args.dir)
    if not directory.is_dir():
        return _fail(f"{directory} is not a directory")
    try:
        checks, findings = check_output(directory)
    except CheckError as exc:
        return _fail(str(exc))

    if args.format == "json":
        print(json.dumps({"ok": not findings, "checks": checks, "findings": findings}, indent=2, sort_keys=True))
    else:
        for c in checks:
            print(f"{c['status']:15} {c['name']}" + (f": {c['detail']}" if c["detail"] else ""))
        for f in findings:
            print(f"{f['path']}: {f['message']} [{f['rule']}]")
    return EXIT_FINDINGS if findings else EXIT_OK


# --- explain ----------------------------------------------------------------


def _cause(finding: dict, report: dict | None) -> dict:
    """Where a finding comes from: the spec field(s) to change, or why the spec is not the cause."""
    rule, path = finding["rule"], finding["path"]
    if not rule.startswith("check."):
        # A `spec validate` finding: its path already is the spec field.
        return {"kind": "spec", "spec_fields": [path], "advice": "Change this field in the spec."}
    if rule.startswith("check.integrity."):
        return {"kind": "integrity", "spec_fields": [],
                "advice": "Rendered files are never edited by hand. Re-run `lzctl render` into an empty directory."}
    if rule == "check.baseline.mismatch":
        return {"kind": "baseline", "spec_fields": ["target.baseline_version"],
                "advice": "The output was rendered with a different baseline than this skill vendors. Re-render with this skill version."}
    if rule == "check.hcl.suppression":
        return {"kind": "template", "spec_fields": [],
                "advice": "Rendered HCL must not carry scanner suppressions. This is a template bug or a hand edit: re-render, and report the template if it persists."}
    if report is None:
        return {"kind": "unknown", "spec_fields": [], "advice": "Pass the rendered directory so the finding can be traced to the spec."}
    sources = report.get("sources")
    fields = sources.get(path) if isinstance(sources, dict) else None
    if isinstance(fields, list) and fields and all(isinstance(f, str) for f in fields):
        return {"kind": "spec", "spec_fields": sorted(fields),
                "advice": "Change one of these spec fields. If every value is valid, the template is wrong: report it as a bug."}
    if path in report["files"]:
        return {"kind": "vendored", "spec_fields": [],
                "advice": "Unmodified upstream baseline file; no spec field drives it. The baseline or its vendored copy is at fault: do not edit it."}
    return {"kind": "unknown", "spec_fields": [], "advice": "This path is not in the render report."}


def explain_findings(findings: list[dict], report: dict | None) -> list[dict]:
    # A file changed after rendering explains every other finding on it; blaming the spec would mislead.
    altered = {f["path"] for f in findings if f["rule"].startswith("check.integrity.") and f["rule"] != "check.integrity.output_hash"}
    explained = []
    for finding in findings:
        if finding["rule"].startswith("check.") and not finding["rule"].startswith("check.integrity.") and finding["path"] in altered:
            cause = {"kind": "integrity", "spec_fields": [],
                     "advice": "This file was changed after rendering, which explains this finding. Re-run `lzctl render` into an empty directory first."}
        else:
            cause = _cause(finding, report)
        explained.append({**finding, "cause": cause})
    return explained


def _read_findings(source: str) -> list[dict]:
    try:
        raw = sys.stdin.read() if source == "-" else Path(source).read_text(encoding="utf-8")
        data = json.loads(raw)
    except FileNotFoundError as exc:
        raise CheckError(f"{source} not found") from exc
    except json.JSONDecodeError as exc:
        raise CheckError(f"{source} is not valid JSON: {exc}") from exc
    findings = data.get("findings") if isinstance(data, dict) else data
    if not isinstance(findings, list) or not all(
        isinstance(f, dict) and all(isinstance(f.get(k), str) for k in ("rule", "path", "message")) for f in findings
    ):
        raise CheckError(f"{source} must hold findings (rule, path, message) or a `check` or `spec validate` result")
    return findings


def cmd_explain(args: argparse.Namespace) -> int:
    directory = Path(args.dir) if args.dir else None
    try:
        report = None
        if directory is not None:
            if not directory.is_dir():
                raise CheckError(f"{directory} is not a directory")
            report = _load_report(directory)
        if args.findings:
            findings = _read_findings(args.findings)
        elif directory is not None:
            findings = check_output(directory)[1]
        else:
            raise CheckError("give a rendered directory to check, or --findings <file|->")
    except CheckError as exc:
        return _fail(str(exc))
    print(json.dumps({"explained": explain_findings(findings, report)}, indent=2, sort_keys=True))
    return EXIT_OK


# --- other commands ---------------------------------------------------------


def cmd_spec_validate(args: argparse.Namespace) -> int:
    path = Path(args.spec)
    try:
        spec = _load_json(path)
    except FileNotFoundError:
        return _fail(f"{path} not found")
    except json.JSONDecodeError as exc:
        return _fail(f"{path} is not valid JSON: {exc}")

    try:
        findings = validate_spec(spec)
    except RuntimeError as exc:
        return _fail(str(exc))

    if args.format == "json":
        print(json.dumps({"valid": not findings, "findings": findings}, indent=2, sort_keys=True))
    elif findings:
        for f in findings:
            print(f"{f['path']}: {f['message']} [{f['rule']}]")
    else:
        print("spec is valid")
    return EXIT_FINDINGS if findings else EXIT_OK


def cmd_doctor(args: argparse.Namespace) -> int:
    checks = []
    py_ok = sys.version_info >= (3, 11)
    checks.append({"name": "python>=3.11", "ok": py_ok, "required": True, "detail": sys.version.split()[0]})
    for module, pip_name in (("jsonschema", "jsonschema"), ("jinja2", "jinja2"), ("yaml", "PyYAML")):
        try:
            __import__(module)
            checks.append({"name": module, "ok": True, "required": True, "detail": metadata.version(pip_name)})
        except ImportError:
            checks.append({"name": module, "ok": False, "required": True, "detail": f"pip install {pip_name}"})
    for tool, purpose in TOOLS.items():
        found = shutil.which(tool)
        checks.append({"name": tool, "ok": bool(found), "required": False, "detail": found or f"missing ({purpose})"})

    ok = all(c["ok"] for c in checks if c["required"])
    if args.format == "json":
        print(json.dumps({"ok": ok, "checks": checks}, indent=2))
    else:
        for c in checks:
            mark = "ok " if c["ok"] else ("MISSING" if c["required"] else "optional-missing")
            print(f"{mark:16} {c['name']}: {c['detail']}")
    return EXIT_OK if ok else EXIT_FINDINGS


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="lzctl", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)

    spec = sub.add_parser("spec", help="spec commands").add_subparsers(dest="spec_command", required=True)
    validate = spec.add_parser("validate", help="validate a spec file")
    validate.add_argument("spec", help="path to the spec JSON file")
    validate.add_argument("--format", choices=["json", "text"], default="json")
    validate.set_defaults(func=cmd_spec_validate)

    render = sub.add_parser("render", help="render a spec into configuration data")
    render.add_argument("spec", help="path to the spec JSON file")
    render.add_argument("--out", required=True, help="output directory (must be empty or absent)")
    render.set_defaults(func=cmd_render)

    check = sub.add_parser("check", help="verify a rendered directory")
    check.add_argument("dir", help="directory written by `lzctl render`")
    check.add_argument("--format", choices=["json", "text"], default="json")
    check.set_defaults(func=cmd_check)

    explain = sub.add_parser("explain", help="map findings back to spec fields")
    explain.add_argument("dir", nargs="?", help="rendered directory; without --findings it is checked first")
    explain.add_argument("--findings", help="JSON from `check` or `spec validate` ('-' for stdin)")
    explain.set_defaults(func=cmd_explain)

    doctor = sub.add_parser("doctor", help="check runtime dependencies")
    doctor.add_argument("--format", choices=["json", "text"], default="json")
    doctor.set_defaults(func=cmd_doctor)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
