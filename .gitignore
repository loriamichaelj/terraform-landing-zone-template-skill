# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files may contain sensitive data
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Plan output files
*.tfplan

# OS / editor
.DS_Store
.idea/
.vscode/

# Python
__pycache__/
.pytest_cache/
.venv/

!evals/**/*.tfvars
